# AK Cafe - E-posta Yapılandırması
# Bu dosyayı .env olarak kopyalayın ve kendi bilgilerinizle doldurun

# SMTP Ayarları
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SECURE=true

# E-posta Ayarları
FROM_EMAIL=info@yourcafe.com
FROM_NAME=Your Cafe Name
TO_EMAIL=reservations@yourcafe.com

# Form Ayarları
CONTACT_FORM_ENABLED=true
RESERVATION_FORM_ENABLED=true

# Güvenlik
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Bildirim Ayarları
NOTIFICATION_EMAIL=true
SMS_NOTIFICATIONS=false

# Örnek Gmail SMTP Ayarları:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_SECURE=true

# Örnek Outlook SMTP Ayarları:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@outlook.com
# SMTP_PASSWORD=your-password
# SMTP_SECURE=true

# Örnek Yandex SMTP Ayarları:
# SMTP_HOST=smtp.yandex.com
# SMTP_PORT=465
# SMTP_USERNAME=your-email@yandex.com
# SMTP_PASSWORD=your-password
# SMTP_SECURE=true

# Not: Gmail kullanıyorsanız "App Password" oluşturmanız gerekebilir
# https://support.google.com/accounts/answer/185833 